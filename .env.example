# ============================================================
# 환경변수 설정 예시 — 실제 값은 절대 커밋하지 마세요!
# 이 파일을 복사해서 .env 파일을 만들고 실제 값을 입력하세요.
# .env 파일은 .gitignore에 포함되어 있어야 합니다.
# ============================================================

# 데이터베이스 (로컬: localhost, EC2: RDS 엔드포인트)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=eodigaljido
DB_USERNAME=your_db_username
DB_PASSWORD=your_strong_db_password_here

# Redis (로컬: localhost, EC2: ElastiCache 엔드포인트)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT 시크릿 (최소 32바이트/256비트 이상)
# 생성 예시: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_use_openssl_rand_base64_32_to_generate

# SOLAPI SMS
SOLAPI_API_KEY=your_solapi_api_key
SOLAPI_API_SECRET=your_solapi_api_secret
SOLAPI_SENDER=01012345678  # 발신 번호

# Google OAuth2  (https://console.cloud.google.com → 사용자 인증 정보)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/oauth/google
GOOGLE_ALLOWED_REDIRECT_URIS=http://localhost:8080/auth/oauth/google,http://localhost:8080/test.html

# Kakao OAuth2  (https://developers.kakao.com → 내 애플리케이션 → 앱 키)
KAKAO_CLIENT_ID=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=your_kakao_client_secret
KAKAO_REDIRECT_URI=http://localhost:8080/auth/oauth/kakao
KAKAO_ALLOWED_REDIRECT_URIS=http://localhost:8080/auth/oauth/kakao,http://localhost:8080/test.html,http://3.36.85.213:8080/test.html,http://3.36.85.213:8080/auth/oauth/kakao

# Browser CORS
CORS_ALLOWED_ORIGINS=https://api.eodigaljido.uk,https://eodigaljido.uk,https://share.eodigaljido.rjsgud.com,https://share-staging.eodigaljido.rjsgud.com,http://localhost:5173,http://localhost:3000,http://localhost:8080

# WebSocket CORS 허용 오리진 (쉼표 구분, 프로덕션에서 반드시 설정)
WEBSOCKET_ALLOWED_ORIGINS=https://api.eodigaljido.uk,https://eodigaljido.uk,http://localhost:3000,http://localhost:5173

# Supabase Storage S3 compatible upload
# Enable S3 protocol in Supabase Storage settings and generate Access Key/Secret.
SUPABASE_S3_ENDPOINT=https://your-project-ref.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-northeast-2
SUPABASE_S3_ACCESS_KEY=your_supabase_s3_access_key
SUPABASE_S3_SECRET_KEY=your_supabase_s3_secret_key
SUPABASE_BUCKET=media
# Optional. If empty, it is derived as:
# https://your-project-ref.supabase.co/storage/v1/object/public/{SUPABASE_BUCKET}
SUPABASE_PUBLIC_BASE_URL=
SUPABASE_S3_PATH_STYLE_ACCESS_ENABLED=true
